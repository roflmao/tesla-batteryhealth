# Copy to .env and fill in. See "Configuration" in README.md.

# Required. Signs sessions and encrypts stored Tesla tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
BH_SECRET_KEY=

# Tesla developer application (developer.tesla.com)
BH_TESLA_CLIENT_ID=
BH_TESLA_CLIENT_SECRET=
BH_TESLA_REDIRECT_URI=https://batteryhealth.example.com/auth/callback
BH_TESLA_FLEET_BASE=https://fleet-api.prd.eu.vn.cloud.tesla.com

# Optional gate in front of the UI, "user:pass". Prefer an SSO proxy.
BH_BASIC_AUTH=

# Bearer token for POST /ingest/telemetry. Leave empty to keep the endpoint closed.
BH_INGEST_TOKEN=

# Defaults shown; uncomment to change.
#BH_DB_PATH=/data/batteryhealth.db
#BH_PUBLIC_KEY_PATH=keys/public-key.pem
#BH_WINDOW_SECONDS=86400
#BH_POLL_SECONDS=900
#BH_IDLE_POLL_SECONDS=1800
#BH_ALLOW_WAKE=0
#BH_MOCK=0

#BH_RUN_LOG_DIR=/data/runs
