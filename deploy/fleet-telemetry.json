{
  "host": "0.0.0.0",
  "port": 4443,
  "log_level": "info",
  "json_log_enable": true,
  "namespace": "tesla",
  "transmit_decoded_records": true,
  "reliable_ack_sources": { "V": "zmq" },
  "zmq": { "addr": "tcp://*:5284" },
  "rate_limit": { "enabled": true, "message_interval_time": 30, "message_limit": 1000 },
  "records": { "V": ["zmq"] },
  "tls": {
    "server_cert": "/certs/fullchain.pem",
    "server_key": "/certs/privkey.pem"
  }
}
